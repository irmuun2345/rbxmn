NODE_ENV=development
PORT=3000

# Signs the session cookie. With NODE_ENV=production the server refuses to
# start unless this is set to something other than the placeholder, because a
# known secret means anyone can forge an admin session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-value

# Encrypts the bot account's .ROBLOSECURITY cookie and its 2FA authenticator
# seed in the database, so a copied robux.db does not hand over the account.
# With NODE_ENV=production the server refuses to start without it. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Losing this key is recoverable but not silent: reconnect the bot account and
# re-enter its 2FA secret in /admin.html and both are stored again.
CREDENTIAL_KEY=

# How many reverse proxies sit in front of this server (nginx = 1, nginx
# behind Cloudflare = 2). Only read in production. Rate limiting and the audit
# log both key on req.ip, so setting this too high lets a client spoof its own
# address via X-Forwarded-For, and too low makes every visitor share one IP.
TRUST_PROXY_HOPS=1

# Roblox Creator Dashboard > OAuth 2.0 Apps
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_OAUTH_REDIRECT_URI=http://localhost:3000/auth/roblox/callback

# Seller purchase verification through Roblox Open Cloud Inventory API
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_SELLER_USER_ID=

# Automatic payment confirmation (QPay).
#
# Leave blank to keep the manual bank-transfer flow — the storefront falls
# back to it on its own and nothing breaks. Fill these in and a confirmed
# payment approves the order and delivers with no admin step.
#
# Register the callback URL with QPay as:
#   https://<your-domain>/payments/qpay/callback
#
# The callback is never trusted on its own: every payment is re-verified
# against QPay's API before an order moves. See src/services/qpay.js.
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Sandbox: https://merchant-sandbox.qpay.mn/v2
QPAY_BASE_URL=https://merchant.qpay.mn/v2

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string. Required in production.
#
# The app used to keep a SQLite file at src/models/robux.db. It cannot on a
# serverless host: the filesystem is per-invocation there, so every order and
# payment written while answering one request is gone by the next.
#
# Leave this blank locally and the app runs PGlite instead — real Postgres
# compiled to WASM, in-process, no server to install. Same SQL dialect as
# production, so a query that works locally works deployed.
#
# In-memory by default, so `npm test` starts from an empty database. Set
# PGLITE_PATH to a directory if local data should survive a restart.
#
# Neon:            postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Vercel Postgres: copy POSTGRES_URL from the storage tab
DATABASE_URL=
# PGLITE_PATH=./.pglite

# Set to `disable` for a local Postgres with no TLS certificate. Neon and
# Vercel Postgres both require TLS, so leave it unset for them.
# PGSSLMODE=disable

# Build the schema on boot instead of as a deploy step.
#
# Off by default against a real Postgres server, because every serverless cold
# start would re-issue the whole schema — and concurrent cold starts racing
# each other on CREATE TABLE fail outright. Deployments run `npm run migrate`
# from the build command instead.
#
# Set to 1 for a local long-running server where a separate migrate step is a
# nuisance. Ignored (always on) when running against PGlite, which starts
# empty every time.
# SCHEMA_ON_BOOT=1

# ---------------------------------------------------------------------------
# Uploaded receipts
# ---------------------------------------------------------------------------

# Vercel Blob token, for storing customers' payment receipts.
#
# Required in production for the same reason as DATABASE_URL: a receipt
# written to the local filesystem is gone by the next request, and an admin
# reviewing a payment would find every file missing.
#
# Created automatically when you add a Blob store to the Vercel project.
# Leave blank locally and receipts go to ./uploads/receipts as before.
#
# Receipts are stored with access: 'private' — they are only ever readable
# through the admin-authenticated route, never by URL.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Scheduled delivery sweep
# ---------------------------------------------------------------------------

# Shared secret for /api/cron/group-orders.
#
# Group orders are delivered by a sweep that has to run on a schedule. A
# long-running server does it on an internal timer; a serverless one cannot
# (the process is frozen between requests), so Vercel Cron calls the route
# instead and authenticates with this.
#
# Without it the route refuses every caller, and no order is ever delivered
# automatically — it does not fall open. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Game Pass ("pending") delivery route. Off unless set to 1.
# The buyer's experience must be Public and age-rated at or above
# GAMEPASS_MIN_AGE_RATING (default 16) — checked live from Roblox before any
# pass is created. See src/services/experience-readiness.js.
GAMEPASS_ROUTE_ENABLED=
GAMEPASS_MIN_AGE_RATING=16
